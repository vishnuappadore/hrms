# ── API (apps/api/.env) ──────────────────────────────────────────
# Runtime connection — NON-OWNER role so RLS applies. Never point this at hayryou_migrator.
DATABASE_URL="postgresql://hayryou_app:hayryou_dev@localhost:5432/hayryou"
# Migration connection — table owner. Used only by `prisma migrate` / CI migrate step.
DIRECT_DATABASE_URL="postgresql://hayryou_migrator:hayryou_dev@localhost:5432/hayryou"

REDIS_URL="redis://localhost:6379"

# JWT — generate real secrets for anything beyond local dev: `openssl rand -base64 48`
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="900"        # seconds (15 min)
JWT_REFRESH_TTL="2592000"   # seconds (30 days)

API_PORT="4000"

# S3 (MinIO locally)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="me-central-1"
S3_ACCESS_KEY="hayryou"
S3_SECRET_KEY="hayryou_dev"
S3_UPLOADS_BUCKET="hayryou-dev-uploads"

# SMTP (Mailpit locally)
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="noreply@hayryou.local"

# ── Web (apps/web/.env.local) ────────────────────────────────────
# Server-side URL the BFF proxy forwards to (not exposed to the browser)
API_URL="http://localhost:4000"
